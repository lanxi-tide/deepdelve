    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "cordis.patch.yml", "README.md", "LICENSE"],
  "license": "MIT",
  "author": "lanxi-tide",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanxi-tide/dsh-heartbeat.git"
  },
  "engines": {
    "node": ">=23"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
